{
  "name": "@omne/sdk",
  "version": "0.1.0",
  "description": "Official TypeScript/JavaScript SDK for Omne Blockchain - Commerce-first blockchain with dual-layer consensus and microscopic fees",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "docs": "typedoc src/index.ts",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "demo": "node examples/basic-usage.js"
  },
  "keywords": [
    "omne",
    "blockchain",
    "cryptocurrency",
    "web3",
    "typescript",
    "javascript",
    "commerce",
    "micropayments",
    "dual-layer-consensus",
    "povera",
    "quar",
    "orc-20"
  ],
  "author": "OmneDAO <dev@omne.org>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/OmneDAO/omne-blockchain.git",
    "directory": "sdk/typescript"
  },
  "bugs": {
    "url": "https://github.com/OmneDAO/omne-blockchain/issues"
  },
  "homepage": "https://omne.org",
  "dependencies": {
    "big.js": "^6.2.1",
    "bip39": "^3.1.0",
    "cross-fetch": "^4.0.0",
    "hdkey": "^2.1.0",
    "js-sha3": "^0.9.3",
    "secp256k1": "^5.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/big.js": "^6.2.2",
    "@types/hdkey": "^2.1.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.7",
    "@types/secp256k1": "^4.0.6",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.7",
    "rollup": "^4.21.0",
    "rollup-plugin-commonjs": "^10.1.0",
    "rollup-plugin-node-resolve": "^5.2.0",
    "rollup-plugin-terser": "^7.0.2",
    "rollup-plugin-typescript2": "^0.36.0",
    "ts-jest": "^29.2.0",
    "typedoc": "^0.26.5",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
